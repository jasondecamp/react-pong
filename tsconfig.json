{
  // Type-checks everything (library, tests, demo, configs). The build uses
  // tsconfig.build.json, which emits src/ only.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "types": ["node", "vitest/globals", "@testing-library/jest-dom/vitest"],
    "noEmit": true,
    // The demo imports the library by package name, resolved to src/ (as in
    // demo/vite.config.ts).
    "paths": {
      "react-pong": ["./src/react/index.ts"],
      "react-pong/core": ["./src/core/index.ts"],
      "react-pong/styles.css": ["./src/styles.css"]
    }
  },
  "include": ["src", "demo", "server", "*.config.ts", "vitest.setup.ts"],
  // The Cloudflare adapter is checked by server/tsconfig.json, against the Workers runtime's types.
  "exclude": ["server/worker.ts"]
}
